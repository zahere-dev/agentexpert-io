---
import Layout from '../../layouts/Layout.astro';
import EmailGate from '../../components/EmailGate.tsx';
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';

export const prerender = false;

const { slug } = Astro.params;
const asset = slug ? await getEntry('assets', slug) : undefined;
---
<Layout title={asset ? asset.data.title : 'Not found'} description={asset?.data.description}>
  <div class="container">
    {asset ? (
      <>
        {asset.data.image && (
          <div class="preview-image">
            <Image src={asset.data.image} alt={asset.data.title} width={960} height={540} />
          </div>
        )}
        <EmailGate
          client:load
          assetId={asset.id}
          title={asset.data.title}
          description={asset.data.description}
          assetType={asset.data.type}
        />
      </>
    ) : (
      <p class="not-found">Nothing here. <a href="/">Back to the homepage →</a></p>
    )}

    <footer class="foot">
      <span>By <a href="https://zahere.com" target="_blank">Zahiruddin Tavargere</a> — Senior GenAI Architect @ Dell</span>
      <div class="foot-links">
        <a href="https://www.youtube.com/@adaptiveengineer" target="_blank" rel="noopener noreferrer">YouTube</a>
        <a href="https://newsletter.adaptiveengineer.com/" target="_blank" rel="noopener noreferrer">Newsletter</a>
      </div>
    </footer>
  </div>
</Layout>

<style>
  .container { max-width: 480px; padding-top: 6rem; padding-bottom: 3rem; }

  .preview-image { border-radius: 12px; overflow: hidden; border: 1px solid var(--border); margin-bottom: 1.25rem; }
  .preview-image :global(img) { display: block; width: 100%; height: auto; }
  .not-found { font-size: 0.9rem; color: var(--muted); text-align: center; }
  .not-found a { border-bottom: 1px solid var(--border); }
  .not-found a:hover { color: var(--text); border-color: var(--text); }

  .foot { font-size: 0.78rem; color: var(--muted); text-align: center; display: flex; flex-direction: column; align-items: center; gap: 0.6rem; margin-top: 3rem; }
  .foot a { border-bottom: 1px solid var(--border); }
  .foot a:hover { color: var(--text); border-color: var(--text); }
  .foot-links { display: flex; gap: 1.25rem; }
</style>
