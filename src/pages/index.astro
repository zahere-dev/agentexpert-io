---
import Layout from '../layouts/Layout.astro';
import AgentSimulator from '../components/AgentSimulator.tsx';
---
<Layout title="agentexpert.io — Think Like an Agent">
  <div class="container">

    <section class="hero">
      <p class="eyebrow">agentexpert.io</p>
      <h1>Think like an agent.</h1>
      <p class="sub">
        Most agent demos hide the hard part: deciding what to do next. Play the
        agent's brain for one mission — pick each step, watch what breaks, see
        how you score.
      </p>
    </section>

    <section class="sim-wrap">
      <AgentSimulator client:load />
    </section>

    <section class="cta" id="download-cta">
      <p class="cta-label">Go further</p>
      <p class="cta-text">
        The playbook behind this loop — patterns, guardrails, and the mistakes
        that don't show up in a demo.
      </p>
      <a href="/get/langchain-certification-prep" class="cta-link">Get the LangChain Certification Prep kit →</a>
    </section>

    <footer class="foot">
      <span>By <a href="https://zahere.com" target="_blank">Zahiruddin Tavargere</a> — Senior Generative AI Architect with 15+ years' experience building enterprise systems</span>
      <div class="foot-links">
        <a href="https://www.youtube.com/@adaptiveengineer" target="_blank" rel="noopener noreferrer">YouTube</a>
        <a href="https://newsletter.adaptiveengineer.com/" target="_blank" rel="noopener noreferrer">Newsletter</a>
      </div>
    </footer>

  </div>
</Layout>

<style>
  .container { max-width: 640px; padding-top: 4.5rem; padding-bottom: 4rem; }

  .hero { margin-bottom: 2.5rem; }
  .eyebrow { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin-bottom: 0.75rem; }
  h1 { font-size: 2.1rem; font-weight: 700; letter-spacing: -0.02em; line-height: 1.2; margin-bottom: 0.85rem; }
  .sub { font-size: 0.95rem; color: var(--muted); max-width: 520px; }

  .sim-wrap { margin-bottom: 3rem; }

  .cta {
    border: 1px solid var(--border);
    background: var(--surface);
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 3rem;
    text-align: center;
  }
  .cta-label { font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 0.4rem; }
  .cta-text { font-size: 0.85rem; color: var(--muted); max-width: 420px; margin: 0 auto 1rem; line-height: 1.6; }
  .cta-link { display: inline-block; font-size: 0.88rem; font-weight: 500; border-bottom: 1px solid var(--text); }
  .cta-link:hover { opacity: 0.7; }

  .foot { font-size: 0.78rem; color: var(--muted); text-align: center; display: flex; flex-direction: column; align-items: center; gap: 0.6rem; }
  .foot a { border-bottom: 1px solid var(--border); }
  .foot a:hover { color: var(--text); border-color: var(--text); }
  .foot-links { display: flex; gap: 1.25rem; }

  @media (max-width: 560px) {
    h1 { font-size: 1.65rem; }
    .container { padding-top: 3rem; }
  }
</style>
